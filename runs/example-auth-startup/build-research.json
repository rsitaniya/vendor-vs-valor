      "flags": []
    },
    {
      "id": "a2cbe3",
      "text": "SuperTokens operates as a stateless service, persisting all user authentication details directly in PostgreSQL.",
      "sources": [
        {
          "url": "https://railway.com/deploy/supertokens",
          "title": "Deploy SuperTokens | Open Source Auth0, AWS Cognito, Okta Alternative",
          "accessed_date": "2026-06-15",
          "source_date": "2026-03-17",
          "locator": {
            "type": "char_span",
            "start": 2928,
            "end": 2990
          },
          "display_quote": "SuperTokens Core is stateless; all auth data lives in Postgres"
        }
      ],
      "dimension": "m9",
      "track": "BUILD",
      "cost_tagged": false,
      "status": "SUPPORTED",
      "flags": []
    },
    {
