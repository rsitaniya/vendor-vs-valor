      "dimension": "m14",
      "track": "BUILD",
      "cost_tagged": false,
      "status": "SUPPORTED",
      "flags": []
    },
    {
      "id": "d5d6c3",
      "text": "SuperTokens requires PostgreSQL version 13.0 or higher for database storage.",
      "sources": [
        {
          "url": "https://supertokens.com/docs/deployment/self-host-supertokens",
          "title": "Self-host SuperTokens | SuperTokens Docs",
          "accessed_date": "2026-06-15",
          "source_date": null,
          "locator": {
            "type": "char_span",
            "start": 476,
            "end": 551
          },
          "display_quote": "The supported database is PostgreSQL. The minimum required version is 13.0."
        }
      ],
      "dimension": "m14",
      "track": "BUILD",
      "cost_tagged": false,
      "status": "SUPPORTED",
      "flags": []
    },
    {
      "id": "ef78b5",
      "text": "Self-hosting Logto on a VPS typically incurs hosting expenses ranging from $5 to $20 per month.",
