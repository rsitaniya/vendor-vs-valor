    {
      "id": "c9e439",
      "text": "The SuperTokens Core service can be deployed directly as a Docker container.",
      "sources": [
        {
          "url": "https://supertokens.com/docs/deployment/self-host-supertokens",
          "title": "Self-host SuperTokens | SuperTokens Docs",
          "accessed_date": "2026-06-15",
          "source_date": null,
          "locator": {
            "type": "char_span",
            "start": 392,
            "end": 445
          },
          "display_quote": "The core service can be deployed using a Docker image"
        }
