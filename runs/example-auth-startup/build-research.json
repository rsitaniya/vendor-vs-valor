      "flags": [
        "partial_evidence"
      ]
    },
    {
      "id": "a9d6e0",
      "text": "At idle, Logto's self-hosted application process consumes approximately 512 MB of RAM.",
      "sources": [
        {
          "url": "https://ossalt.com/guides/logto-vs-keycloak-2026",
          "title": "Logto vs Keycloak: Modern DX vs Enterprise Power 2026",
          "accessed_date": "2026-06-15",
          "source_date": "2026-03-08",
          "locator": {
            "type": "char_span",
            "start": 4104,
