  "priority_dimensions": [
    {
      "id": "m9",
      "why": "Strict SEBI regulations and NSE/BSE commercial data redistribution licensing form severe legal compliance gates for a self-built infrastructure."
    },
    {
      "id": "m3",
      "why": "Ingesting and cleaning 20 years of 1-minute historical tick data and corporate actions with 4 engineers presents massive upfront opportunity cost."
    },
    {
      "id": "m6",
      "why": "The strict 8-week staging timeline for historical OHLCV data leaves very little margin for building custom ETL pipelines from scratch."
    },
    {
      "id": "m4",
      "why": "Ongoing corporate actions reconciliation (splits, dividends, mergers) is a continuous maintenance and quality control overhead."
    },
    {
      "id": "m14",
      "why": "Integrating multi-source feeds (NSE/BSE, AMFI) into TimescaleDB and Kafka requires complex schema design and low-latency tuning."
    }
  ],
