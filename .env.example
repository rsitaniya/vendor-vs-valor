# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Gemini (default provider) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids. Never hard-code these in a node — only here, read via the provider interface.
# Verify the exact ids available to your account; these are sensible defaults.
# Verify ids against your key: `client.models.list()`. Not all tiers exist per key.
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_MODEL_PRO=gemini-3.1-pro-preview

# --- Provider selection ---
# The provider interface picks its implementation from this. Swappable to claude/openai later.
LLM_PROVIDER=gemini

# --- Engine ---
# Bumped manually on logic changes; part of the input-hash guard (spec §4).
ENGINE_VERSION=0.1.0
